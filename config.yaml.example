# Set the environment variables for the web application
# WEB_VERSION: dev
# Set APIKEY
MINIMAX_API_KEY:
VOLCENGINE_API_KEY:
BIGMODEL_API_KEY:
RUNNINGHUB_API_KEY:
# Optional: only needed when authentication is enabled on the Strata server
STRATA_API_KEY:
# Optional: used when the Strata node's base_url is empty; falls back to http://127.0.0.1:8080/v1
STRATA_BASE_URL:
# Set ComfyUI url for skill
COMFYUI_URL:
